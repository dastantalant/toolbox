<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.toolbox</groupId>
        <artifactId>toolbox</artifactId>
        <version>0.0.4</version>
    </parent>

    <packaging>pom</packaging>

    <modules>
        <module>excel-api</module>
        <module>excel-fast</module>
        <module>excel-poi</module>
        <module>excel-processor</module>
        <module>excel-test</module>
    </modules>

    <groupId>com.toolbox.excel</groupId>
    <artifactId>excel</artifactId>

    <properties>
        <aalto.version>1.3.4</aalto.version> <!-- Sep 27, 2025 -->
        <poi.version>5.5.1</poi.version> <!-- Nov 30, 2025 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml</groupId>
                <artifactId>aalto-xml</artifactId>
                <version>${aalto.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>3.1.1</version> <!-- Feb 01, 2025 -->
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>6.0.1</version> <!-- Jul 19, 2024 -->
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>org.hibernate.validator</groupId>
                <artifactId>hibernate-validator</artifactId>
                <version>9.1.0.Final</version> <!-- Nov 07, 2025 -->
                <scope>compile</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-to-slf4j</artifactId>
                <version>2.25.3</version> <!-- Dec 16, 2025 -->
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>2.0.17</version> <!-- Feb 25, 2025 -->
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>